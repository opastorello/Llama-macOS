    "Changes restart the server, which unloads the current model.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios reinician el servidor, lo que descarga el modelo actual."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações reiniciam o servidor, o que descarrega o modelo atual."
          }
        }
      }
    },
    "Chat": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
