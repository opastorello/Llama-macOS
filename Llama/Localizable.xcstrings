        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Chatear con el modelo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversar com o modelo"
          }
        }
      }
    },
    "Check your internet connection and try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba tu conexión a internet e inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique sua conexão com a internet e tente novamente."
          }
        }
      }
    },
    "Choose a directory for downloaded models": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una carpeta para los modelos descargados"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma pasta para os modelos baixados"
          }
        }
      }
    },
    "Choose a folder with an index.html to serve as the web app": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una carpeta con un index.html para servir como app web"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma pasta com um index.html para servir como app web"
          }
        }
      }
    },
    "Choose the folder that holds your web app's index.html -- for a project with a build step, that's usually its build output.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la carpeta que contiene el index.html de tu app web. En un proyecto con paso de compilación, suele ser su salida de compilación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a pasta que contém o index.html do seu app web. Em um projeto com etapa de build, geralmente é a saída do build."
          }
        }
      }
    },
    "Choose…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegir…"
