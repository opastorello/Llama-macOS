        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível baixar %@.\n\n%@"
          }
        }
      }
    },
    "Could not estimate memory — using 4k context": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Memoria no estimada — usando contexto de 4k"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Memória não estimada — usando contexto de 4k"
          }
        }
      }
    },
    "Couldn't install the llama binary: %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo instalar el binario de llama: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível instalar o binário do llama: %@"
          }
        }
      }
    },
    "Couldn't open staging file: %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir el archivo temporal: %@"
          }
