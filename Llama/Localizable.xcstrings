    "Agent mode": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo agente"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo agente"
          }
        }
      }
    },
    "Agent mode is on, so anyone who connects would get file access.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo agente está activado, así que cualquiera que se conecte tendría acceso a los archivos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo agente está ativado, então qualquer pessoa que se conectar teria acesso aos arquivos."
          }
        }
      }
    },
    "Aliases": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alias"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aliases"
          }
        }
      }
    },
    "Allow network access": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir acceso a la red"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir acesso à rede"
          }
        }
      }
    },
    "Anyone on your current network can reach the server. It has no password -- only turn this on for a network you trust.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquiera en tu red actual puede acceder al servidor. No tiene contraseña: actívalo solo en una red de confianza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer pessoa na sua rede atual pode acessar o servidor. Ele não tem senha: ative apenas em uma rede de confiança."
          }
        }
      }
    },
    "Ask Llama…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta a Llama…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte ao Llama…"
          }
        }
      }
    },
    "Bound to an address set outside the app.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinculado a una dirección definida fuera de la app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinculado a um endereço definido fora do app."
          }
        }
      }
    },
