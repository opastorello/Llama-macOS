    "The port the server listens on. Default %@.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El puerto en el que escucha el servidor. Predeterminado: %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A porta em que o servidor escuta. Padrão: %@."
          }
        }
      }
    },
    "The server hands out every file in the folder, so %@ would be readable too. Choose the folder with just the built web app -- usually build or dist.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor entrega todos los archivos de la carpeta, así que %@ también sería legible. Elige la carpeta solo con la app web compilada: normalmente build o dist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor entrega todos os arquivos da pasta, então %@ também ficaria legível. Escolha a pasta só com o app web compilado — geralmente build ou dist."
          }
        }
      }
    },
    "The server stops while Llama restarts, and the loaded model is unloaded.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor se detiene mientras Llama se reinicia y el modelo cargado se descarga."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor para enquanto o Llama reinicia, e o modelo carregado é descarregado."
          }
        }
      }
    },
    "The sign-in response didn’t match the request. Try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La respuesta del inicio de sesión no coincidió con la solicitud. Inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A resposta do login não correspondeu à requisição. Tente novamente."
          }
        }
      }
    },
    "There's already an alias named %@.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe un alias llamado %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já existe um alias chamado %@."
          }
        }
      }
    },
    "This folder has a %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta carpeta contiene %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pasta contém %@"
          }
        }
      }
    },
    "This model is gated. Sign in to Hugging Face in Settings > Advanced, then request access on its page:\n%@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo está restringido. Inicia sesión en Hugging Face en Ajustes > Avanzado y solicita acceso en su página:\n%@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo é restrito. Entre no Hugging Face em Ajustes > Avançado e solicite acesso na página dele:\n%@"
          }
        }
      }
    },
    "This model isn't installed, so requests for %@ fail until it is or you pick another.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo no está instalado, así que las solicitudes para %@ fallan hasta que lo esté o elijas otro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo não está instalado, então as requisições para %@ falham até que ele seja instalado ou você escolha outro."
          }
        }
      }
    },
    "This model requires %@ of free space, but only %@ is available. Please free up some space.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
