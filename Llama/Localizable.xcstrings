        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir o arquivo temporário: %@"
          }
        }
      }
    },
    "Couldn't reach Hugging Face to start the download. This is usually a temporary rate limit or outage — try again in a few minutes, or sign in to Hugging Face in Settings to lift the limit.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo acceder a Hugging Face para iniciar la descarga. Suele ser un límite de solicitudes o una caída temporal: inténtalo de nuevo en unos minutos o inicia sesión en Hugging Face en Ajustes para quitar el límite."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar o Hugging Face para iniciar o download. Geralmente é um limite de requisições ou uma instabilidade temporária — tente novamente em alguns minutos ou entre no Hugging Face em Ajustes para remover o limite."
          }
        }
      }
    },
    "Couldn't reopen staging file for retry: %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo reabrir el archivo temporal para reintentar: %@"
          }
