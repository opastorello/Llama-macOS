{
  "sourceLanguage": "en",
  "strings": {
    "%@ (not installed)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (no instalado)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (não instalado)"
          }
        }
      }
    },
    "%@ ctx": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ctx"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ctx"
          }
        }
      }
    },
    "%@ defines a model named %@.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ define un modelo llamado %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ define um modelo chamado %@."
          }
        }
      }
    },
    "%@ doesn’t contain any GGUF files.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no contiene ningún archivo GGUF."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não contém nenhum arquivo GGUF."
          }
        }
      }
    },
    "%@ is already installed": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya está instalado"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ já está instalado"
          }
        }
      }
    },
    "%@ is gated or private.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ es restringido o privado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ é restrito ou privado."
          }
        }
      }
    },
    "%@ is too large for this Mac.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ es demasiado grande para este Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ é grande demais para este Mac."
          }
        }
      }
    },
    "%@ of %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de %@"
          }
        }
      }
    },
    "%@ sets this model's aliases to %@, which replaces this one.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ establece los alias de este modelo en %@, lo que sustituye a este."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ define os aliases deste modelo como %@, o que substitui este."
          }
        }
      }
    },
    "%@ tokens": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tokens"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tokens"
          }
        }
      }
    },
    "%@. Choose a smaller model or upgrade your system memory.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Elige un modelo más pequeño o usa un Mac con más memoria."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Escolha um modelo menor ou use um Mac com mais memória."
          }
        }
      }
    },
    "4k ctx": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "4k ctx"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "4k ctx"
          }
        }
      }
    },
    "A custom web app is set, so anyone who connects could read every file in its folder.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una app web personalizada configurada, así que cualquiera que se conecte podría leer todos los archivos de su carpeta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há um app web personalizado configurado, então qualquer pessoa que se conectar poderia ler todos os arquivos da pasta dele."
          }
        }
      }
    },
    "A keyboard shortcut that opens a prompt window from any app.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un atajo de teclado que abre una ventana de prompt desde cualquier app."
